# Todas opcionais. Sem elas, o app usa a API gratuita (não comercial) do Open-Meteo.

# Plano comercial do Open-Meteo (obrigatório ao cobrar pelo serviço)
# VITE_OPEN_METEO_HOST=https://customer-api.open-meteo.com
# VITE_OPEN_METEO_GEOCODING_HOST=https://customer-geocoding-api.open-meteo.com
# VITE_OPEN_METEO_ARCHIVE_HOST=https://customer-archive-api.open-meteo.com
# VITE_OPEN_METEO_API_KEY=

# E-mail exibido na página inicial e nos botões de contato
# VITE_CONTACT_EMAIL=contato@seudominio.com.br
